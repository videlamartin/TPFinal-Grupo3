<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>QuizMaster · Perfil</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎯</text></svg>">
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
    <link rel="stylesheet" href="/public/css/quizmaster.css">
    <script src="/public/js/tema.js"></script>
    <link rel="stylesheet" href="/public/css/perfil.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
</head>
<body>

{{> navbar}}

<main class="qm-page qm-page-narrow">

    <div class="qm-card perfil-card qm-aparecer">
        <div class="perfil-top">
            {{#foto_perfil}}
                <img src="{{foto_perfil}}" class="perfil-avatar" alt="Foto de perfil">
            {{/foto_perfil}}
            {{^foto_perfil}}
                <div class="perfil-avatar perfil-avatar-ph">👤</div>
            {{/foto_perfil}}
            <div class="perfil-id">
                <h1>{{nombre_completo}}</h1>
                <p class="perfil-user">@{{username}}</p>
                <span class="perfil-rol">{{rol}}</span>
            </div>
        </div>

        <div class="perfil-stats">
            <div class="perfil-stat">
                <div class="n">{{puntaje_total}}</div>
                <div class="l">Puntaje</div>
            </div>
            <div class="perfil-stat">
                <div class="n">{{partidas_jugadas}}</div>
                <div class="l">Partidas</div>
            </div>
        </div>

        <div class="qm-card-pad">
            <table class="qm-table perfil-datos">
                <tbody>
                    <tr><td class="k">Email</td><td>{{email}}</td></tr>
                    <tr><td class="k">País</td><td>{{pais}}</td></tr>
                    <tr><td class="k">Ciudad</td><td>{{ciudad}}</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="qm-card qm-card-pad qm-aparecer" style="margin-top:18px;">
        <h2 class="qm-title" style="font-size:1.2rem; margin-bottom:14px;">Historial de partidas</h2>
        <div style="overflow-x:auto;">
            <table class="qm-table">
                <thead><tr><th>Fecha</th><th>Puntaje</th></tr></thead>
                <tbody>
                    {{#historial}}
                    <tr><td>{{fecha_inicio}}</td><td><b>{{puntaje}}</b> pts</td></tr>
                    {{/historial}}
                    {{^historial}}
                    <tr><td colspan="2" style="color:var(--qm-muted);">No hay partidas registradas.</td></tr>
                    {{/historial}}
                </tbody>
            </table>
        </div>
    </div>

    <div class="qm-grid perfil-abajo qm-aparecer" style="margin-top:18px;">
        <div class="qm-card qm-card-pad">
            <h2 class="qm-title" style="font-size:1.2rem; margin-bottom:14px;">Ubicación</h2>
            <div id="mapa-perfil" data-ciudad="{{ciudad}}" data-pais="{{pais}}" class="perfil-mapa"></div>
            <p class="perfil-ubic">📍 {{ciudad}}, {{pais}}</p>
        </div>

        <div class="qm-card qm-card-pad" style="text-align:center;">
            <h2 class="qm-title" style="font-size:1.2rem; margin-bottom:14px;">Mi código QR</h2>
            <img src="{{qr_url}}" alt="QR del perfil" class="perfil-qr">
            <p class="perfil-qr-help">Compartí tu perfil escaneando este código.</p>
        </div>
    </div>

</main>

<script src="/public/js/perfil.js"></script>
</body>
</html>
