<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>QuizMaster · {{#es_modificar}}Editar{{/es_modificar}}{{^es_modificar}}Nueva{{/es_modificar}} pregunta</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎯</text></svg>">
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
    <link rel="stylesheet" href="/public/css/quizmaster.css">
    <script src="/public/js/tema.js"></script>
    <link rel="stylesheet" href="/public/css/editor-form.css">
</head>
<body>

{{> navbar}}

<main class="qm-page qm-page-narrow">

    <div class="qm-page-head qm-aparecer">
        <div class="qm-eyebrow">Panel de editor</div>
        <h1 class="qm-title">{{#es_modificar}}Editar pregunta{{/es_modificar}}{{^es_modificar}}Nueva pregunta{{/es_modificar}}</h1>
    </div>

    <div class="qm-card qm-card-pad qm-aparecer">
        <form method="POST" action="{{#es_modificar}}/editor/modificar{{/es_modificar}}{{^es_modificar}}/editor/crear{{/es_modificar}}">

            {{#es_modificar}}<input type="hidden" name="id" value="{{id}}">{{/es_modificar}}

            <div class="qm-field">
                <label>Enunciado</label>
                <textarea name="enunciado" class="qm-textarea" rows="3" required>{{enunciado}}</textarea>
            </div>

            <div class="qm-field">
                <label>Categoría</label>
                <select name="categoria_id" class="qm-select" required>
                    {{#categorias}}
                    <option value="{{id}}" {{#seleccionada}}selected{{/seleccionada}}>{{nombre}}</option>
                    {{/categorias}}
                </select>
            </div>

            <div class="qm-field">
                <label>Respuestas</label>
                <p class="form-hint">Marcá con el círculo cuál es la correcta.</p>

                {{#respuestas}}
                <div class="respuesta-row">
                    <div class="respuesta-radio">
                        <input type="radio" name="respuesta_correcta" value="{{indice}}" {{#es_correcta}}checked{{/es_correcta}} required>
                    </div>
                    <div class="respuesta-input">
                        {{#es_modificar}}<input type="hidden" name="respuesta_id[]" value="{{id}}">{{/es_modificar}}
                        <input type="text" name="respuesta_texto[]" value="{{texto}}" class="qm-input"
                               placeholder="Respuesta {{indice_display}}" required>
                    </div>
                </div>
                {{/respuestas}}

                {{^respuestas}}
                {{#campos_crear}}
                <div class="respuesta-row">
                    <div class="respuesta-radio">
                        <input type="radio" name="respuesta_correcta" value="{{indice}}" required>
                    </div>
                    <div class="respuesta-input">
                        <input type="text" name="respuesta_texto[]" class="qm-input"
                               placeholder="Respuesta {{indice_display}}" required>
                    </div>
                </div>
                {{/campos_crear}}
                {{/respuestas}}
            </div>

            <button type="submit" class="qm-btn qm-btn-ok qm-btn-block" style="margin-top:8px;">
                {{#es_modificar}}Guardar cambios{{/es_modificar}}{{^es_modificar}}Crear pregunta{{/es_modificar}}
            </button>
            <a href="/editor/ver" class="qm-btn qm-btn-outline qm-btn-block" style="margin-top:10px;">Cancelar</a>

        </form>
    </div>

</main>

</body>
</html>
