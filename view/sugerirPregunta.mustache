<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>QuizMaster · Sugerir pregunta</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎯</text></svg>">
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
    <link rel="stylesheet" href="/public/css/quizmaster.css">
    <script src="/public/js/tema.js"></script>
    <link rel="stylesheet" href="/public/css/editor-form.css">
</head>
<body>

{{> navbar}}

<main class="qm-page qm-page-narrow">

    <div class="qm-page-head qm-aparecer">
        <div class="qm-eyebrow">Jugadores</div>
        <h1 class="qm-title">Sugerir una pregunta</h1>
        <p class="qm-subtitle">Tu pregunta será revisada por un editor antes de aparecer en el juego.</p>
    </div>

    <div class="qm-card qm-card-pad qm-aparecer">
        <form method="POST" action="/lobby/sugerirGuardar">

            <div class="qm-field">
                <label>Enunciado</label>
                <textarea name="enunciado" class="qm-textarea" rows="3" required></textarea>
            </div>

            <div class="qm-field">
                <label>Categoría</label>
                <select name="categoria_id" class="qm-select" required>
                    <option value="" disabled selected>Seleccioná una categoría</option>
                    {{#categorias}}
                    <option value="{{id}}">{{nombre}}</option>
                    {{/categorias}}
                </select>
            </div>

            <div class="qm-field">
                <label>Respuestas</label>
                <p class="form-hint">Marcá con el círculo cuál es la correcta.</p>

                {{#campos_crear}}
                <div class="respuesta-row">
                    <div class="respuesta-radio">
                        <input type="radio" name="respuesta_correcta" value="{{indice}}" required>
                    </div>
                    <div class="respuesta-input">
                        <input type="text" name="respuesta_texto[]" class="qm-input"
                               placeholder="Respuesta {{indice_display}}" required>
                    </div>
                </div>
                {{/campos_crear}}
            </div>

            <button type="submit" class="qm-btn qm-btn-ok qm-btn-block" style="margin-top:8px;">Enviar sugerencia</button>
            <a href="/lobby/ver" class="qm-btn qm-btn-outline qm-btn-block" style="margin-top:10px;">Cancelar</a>

        </form>
    </div>

</main>

</body>
</html>
