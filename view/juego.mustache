<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>QuizMaster · Partida</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎯</text></svg>">
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
    <link rel="stylesheet" href="/public/css/quizmaster.css">
    <script src="/public/js/tema.js"></script>
    <link rel="stylesheet" href="/public/css/juego.css">
</head>
<body class="{{categoria_actual}}">

<div id="ruleta-overlay">
    <div class="ruleta-aguja"></div>
    <div id="ruleta"></div>
    <div id="ruleta-texto">Sorteando categoría...</div>
</div>

<div class="contenedor-juego">

    <div class="juego-brand">
        <span class="qm-mark juego-mark"></span>
        <span>Quiz<b>Master</b></span>
    </div>

    <div class="qm-card game-card">

        <div class="timer-wrap">
            <div class="timer-row">
                <span>Tiempo</span>
                <span><span class="timer-num" id="timer-num">{{tiempo_limite}}</span> s</span>
            </div>
            <div class="barra-tiempo">
                <div id="barra-tiempo-fill"></div>
            </div>
        </div>

        <div class="game-cat">
            <span class="qm-badge" style="background: {{categoria_color}};">{{categoria}}</span>
        </div>

        <h1 class="game-question">{{pregunta}}</h1>

        <form action="/partida/responder" method="POST" class="game-answers">
            {{#respuestas}}
                <button type="submit" name="respuesta_id" value="{{id}}" class="game-answer">
                    <span class="game-answer-txt">{{texto}}</span>
                </button>
            {{/respuestas}}
        </form>

        <form id="form-timeout" action="/partida/responder" method="POST" style="display:none;">
            <input type="hidden" name="respuesta_id" value="0">
        </form>

        <div class="game-foot">
            <span>Puntaje: <b>{{puntaje_actual}}</b></span>
        </div>

    </div>
</div>

<!-- Variables del servidor para el JS -->
<script>
    var tiempoTotal     = {{tiempo_limite}};
    var tiempoFin       = {{tiempo_fin}}; // timestamp en ms (hora real del servidor)
    var categoriaActual = "{{categoria_actual}}";
    var colorActual     = "{{categoria_color_actual}}";
</script>
<script src="/public/js/juego.js"></script>

</body>
</html>
