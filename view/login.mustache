<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>QuizMaster · Iniciar sesión</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎯</text></svg>">
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
    <link rel="stylesheet" href="/public/css/quizmaster.css">
    <script src="/public/js/tema.js"></script>
    <link rel="stylesheet" href="/public/css/login.css">
</head>
<body class="auth-body">

<div class="auth-wrapper">

    <div class="auth-brand">
        <span class="qm-mark auth-mark"></span>
        <h1>Quiz<span>Master</span></h1>
        <p>¡Demostrá cuánto sabés!</p>
    </div>

    <div class="qm-card qm-card-pad auth-card qm-aparecer">
        <form action="/login/login" method="POST">

            <div class="qm-field">
                <label for="username">Usuario</label>
                <input class="qm-input" trype="text" id="usename" name="username" placeholder="Tu nombre de usuario">
            </div>

            <div class="qm-field">
                <label for="password">Contraseña</label>
                <input class="qm-input" type="password" id="password" name="password" placeholder="••••••">
            </div>

            {{#error}}
                <div class="qm-alert-error" id="error-server">⚠ {{error}}</div>
            {{/error}}
            <div class="qm-alert-error" id="error-cliente" style="display:none;"></div>

            <button class="qm-btn qm-btn-primary qm-btn-block" style="margin-top:8px;">Ingresar</button>
        </form>

        <p class="auth-alt">
            ¿No tenés cuenta? <a href="/registro/ver">Registrate acá</a>
        </p>
    </div>

    <div class="auth-cats">
        <span class="cat" style="background:var(--qm-cat-historia)"></span>
        <span class="cat" style="background:var(--qm-cat-deportes)"></span>
        <span class="cat" style="background:var(--qm-cat-ciencia)"></span>
        <span class="cat" style="background:var(--qm-cat-arte)"></span>
        <span class="cat" style="background:var(--qm-cat-entretenimiento)"></span>
        <span class="cat" style="background:var(--qm-cat-geografia)"></span>
    </div>

</div>

<script src="/public/js/login.js"></script>
</body>
</html>
