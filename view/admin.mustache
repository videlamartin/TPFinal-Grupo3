<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>QuizMaster · Reportes</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎯</text></svg>">
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
    <link rel="stylesheet" href="/public/css/quizmaster.css">
    <script src="/public/js/tema.js"></script>
    <link rel="stylesheet" href="/public/css/admin.css">
</head>
<body>

{{> navbar}}

<main class="qm-page">

    <div class="admin-head qm-aparecer">
        <div>
            <div class="qm-eyebrow">Administración</div>
            <h1 class="qm-title">Reportes y estadísticas</h1>
        </div>
        <div class="admin-tools">
            <form method="GET" action="/admin/ver" class="admin-filtro">
                <select name="periodo" class="qm-select">
                    <option value="dia">Día</option>
                    <option value="semana">Semana</option>
                    <option value="mes">Mes</option>
                    <option value="anio">Año</option>
                </select>
                <button class="qm-btn qm-btn-primary">Filtrar</button>
            </form>
            <button onclick="imprimirGraficos();" class="qm-btn qm-btn-outline">🖨 Imprimir</button>
        </div>
    </div>

    <div class="qm-grid admin-grid qm-aparecer">

        <div class="qm-card qm-card-pad admin-chart-card">
            <h2>Usuarios registrados</h2>
            <p class="admin-desc">Cuentas nuevas creadas en cada período. Sirve para ver si la comunidad crece.</p>
            <div class="admin-chart"><canvas id="usuariosChart"></canvas></div>
        </div>

        <div class="qm-card qm-card-pad admin-chart-card">
            <h2>Partidas jugadas</h2>
            <p class="admin-desc">Total de partidas completadas por período. Mide qué tan activa está la app.</p>
            <div class="admin-chart"><canvas id="partidasChart"></canvas></div>
        </div>

        <div class="qm-card qm-card-pad admin-chart-card">
            <h2>Preguntas totales</h2>
            <p class="admin-desc">Preguntas disponibles en el juego a lo largo del tiempo.</p>
            <div class="admin-chart"><canvas id="graficoPreguntas"></canvas></div>
        </div>

        <div class="qm-card qm-card-pad admin-chart-card">
            <h2>Usuarios por país</h2>
            <p class="admin-desc">De qué países son los jugadores registrados.</p>
            <div class="admin-chart"><canvas id="usuariosPaisChart"></canvas></div>
        </div>

        <div class="qm-card qm-card-pad admin-chart-card">
            <h2>Usuarios por sexo</h2>
            <p class="admin-desc">Distribución de jugadores según el sexo cargado al registrarse.</p>
            <div class="admin-chart"><canvas id="usuariosSexoChart"></canvas></div>
        </div>

        <div class="qm-card qm-card-pad admin-chart-card">
            <h2>Usuarios por edad</h2>
            <p class="admin-desc">Cantidad de jugadores en cada franja etaria.</p>
            <div class="admin-chart"><canvas id="usuariosEdadChart"></canvas></div>
        </div>

    </div>

</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    window.graficoUsuarios  = '{{{grafico_usuarios}}}';
    window.graficoPartidas  = '{{{grafico_partidas}}}';
    window.graficoPreguntas = '{{{grafico_preguntas}}}';
    window.usuariosPorPais  = '{{{usuarios_por_pais}}}';
    window.usuariosPorSexo  = '{{{usuarios_por_sexo}}}';
    window.usuariosPorEdad  = '{{{usuarios_por_edad}}}';
</script>

<script>
    function imprimirGraficos() {
        Object.values(Chart.instances).forEach(chart => { chart.resize(); chart.update(); });
        setTimeout(() => { window.print(); }, 300);
    }
</script>

<script src="/public/js/admin.js"></script>

</body>
</html>
