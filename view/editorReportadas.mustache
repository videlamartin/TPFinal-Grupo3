<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>QuizMaster · Preguntas reportadas</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎯</text></svg>">
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
    <link rel="stylesheet" href="/public/css/quizmaster.css">
    <script src="/public/js/tema.js"></script>
    <link rel="stylesheet" href="/public/css/editor.css">
</head>
<body>

{{> navbar}}

<main class="qm-page">

    <div class="editor-barra qm-aparecer">
        <div>
            <div class="qm-eyebrow">Panel de editor</div>
            <h1 class="qm-title">Preguntas reportadas</h1>
        </div>
        <div class="acciones-editor no-print">
            <button type="button" onclick="window.print()" class="qm-btn qm-btn-outline">🖨 Imprimir</button>
            <a href="/editor/ver" class="qm-btn qm-btn-primary">Ver preguntas</a>
        </div>
    </div>

    <div class="preguntas-grid qm-aparecer">
        {{#reportes}}
        <div class="pregunta-card">
            <div class="pregunta-header">
                <span class="categoria-badge" style="background:var(--qm-danger); margin:0;">Reportada</span>
                <span class="estado-pregunta">{{fecha_reporte}}</span>
            </div>
            <h3 class="pregunta-enunciado">{{enunciado}}</h3>
            <p><strong>Usuario:</strong> {{username}}</p>
            <p><strong>Motivo:</strong> {{motivo}}</p>
            <div class="acciones no-print">
                <form method="POST" action="/editor/mantenerReporte">
                    <input type="hidden" name="reporte_id" value="{{reporte_id}}">
                    <button type="submit" class="qm-btn qm-btn-ok">Mantener</button>
                </form>
                <form method="POST" action="/editor/eliminar" onsubmit="return confirm('¿Dar de baja esta pregunta?')">
                    <input type="hidden" name="id" value="{{pregunta_id}}">
                    <input type="hidden" name="desde_reportes" value="1">
                    <button type="submit" class="qm-btn qm-btn-danger">Dar de baja</button>
                </form>
            </div>
        </div>
        {{/reportes}}

        {{^reportes}}
        <div class="sin-resultados">No hay preguntas reportadas.</div>
        {{/reportes}}
    </div>

</main>

</body>
</html>
