<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>QuizMaster · Editor</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎯</text></svg>">
    <link rel="stylesheet" href="https://www.w3schools.com/w3css/4/w3.css">
    <link rel="stylesheet" href="/public/css/quizmaster.css">
    <script src="/public/js/tema.js"></script>
    <link rel="stylesheet" href="/public/css/editor.css">
</head>
<body>

{{> navbar}}

<main class="qm-page">

    <div class="qm-page-head qm-aparecer">
        <div class="qm-eyebrow">Panel de editor</div>
        <h1 class="qm-title">Preguntas del juego</h1>
    </div>

    <div class="editor-barra qm-aparecer">
        <div class="acciones-editor">
            <a href="/editor/crear" class="qm-btn qm-btn-ok">+ Nueva pregunta</a>
            <a href="/editor/reportadas" class="qm-btn qm-btn-outline">⚑ Reportadas</a>
            <a href="/editor/sugeridas" class="qm-btn qm-btn-outline">💡 Sugeridas</a>
        </div>
    </div>

    <form method="GET" action="/editor/ver" class="buscador-container qm-aparecer">
        <input type="text" name="busqueda" value="{{busqueda}}"
               placeholder="Buscar por enunciado..." class="qm-input">
        <button type="submit" class="qm-btn qm-btn-primary">Buscar</button>
    </form>

    <div class="preguntas-grid qm-aparecer">
        {{#preguntas}}
        <div class="pregunta-card">
            <div class="pregunta-header">
                <span class="categoria-badge" style="background:{{categoria_color}}; margin:0;">{{categoria_nombre}}</span>
                <span class="estado-pregunta">{{estado}}</span>
            </div>
            <h3 class="pregunta-enunciado">{{enunciado}}</h3>
            <div class="acciones">
                <a href="/editor/modificar?id={{id}}" class="qm-btn qm-btn-primary">Editar</a>
                <form method="POST" action="/editor/eliminar" onsubmit="return confirm('¿Rechazar esta pregunta?')">
                    <input type="hidden" name="id" value="{{id}}">
                    <button type="submit" class="qm-btn qm-btn-danger">Rechazar</button>
                </form>
            </div>
        </div>
        {{/preguntas}}

        {{^preguntas}}
        <div class="sin-resultados">No hay preguntas que coincidan con la búsqueda.</div>
        {{/preguntas}}
    </div>

</main>

</body>
</html>
